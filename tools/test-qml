#!/usr/bin/bash
set -euo pipefail
project=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
app_qml_imports=$(mktemp -d)
trap 'rm -rf -- "$app_qml_imports"' EXIT
mkdir -p "$app_qml_imports/qs"
cp -a /usr/share/omarchy/shell/Ui /usr/share/omarchy/shell/Commons "$app_qml_imports/qs/"
QT_QPA_PLATFORM=offscreen QML_XHR_ALLOW_FILE_READ=1 /usr/lib/qt6/bin/qmltestrunner \
  -input "$project/tests/qml" -import /usr/share/omarchy/shell \
  -import "$app_qml_imports" -import "$project/tests/qml-support"
