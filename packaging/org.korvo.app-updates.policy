<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Omarchy Apps</vendor>
  <action id="org.korvo.app-updates.execute">
    <description>Preparar e instalar el alcance aprobado en Apps</description>
    <message>Autoriza la preparación administrativa de las actualizaciones. El alcance final se revisa en el panel antes de instalar.</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/omarchy-app-updates/app-updates-helper</annotate>
  </action>
</policyconfig>
